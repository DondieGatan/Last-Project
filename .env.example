# Copy this file to .env and fill in real values. Never commit .env itself
# (it's already in .gitignore) — this file is just the template.

# --- Flask ---
# A long random string. If left unset, the app generates and persists one
# locally in .flask_secret_key for convenience during development, but a
# real deployment should always set this explicitly so sessions survive
# restarts/redeploys and multiple app instances share the same key.
SECRET_KEY=

# --- Database (Microsoft SQL Server) ---
SQL_SERVER=localhost
SQL_DATABASE=smart_resume_analyser
SQL_DRIVER={ODBC Driver 17 for SQL Server}
# yes = Windows/Trusted authentication (local dev default).
# For SQL Server authentication, set this to "no" and fill in SQL_USERNAME/SQL_PASSWORD.
SQL_TRUSTED_CONNECTION=yes
SQL_USERNAME=
SQL_PASSWORD=

# --- Email (used for password-reset codes) ---
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=
